page 2 (
    name: Knowledge Sources
    alias: KNOWLEDGE-SOURCES
    title: Knowledge Sources
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region about-this-page (
        name: About this page
        type: staticContent
        source {
            htmlCode:
                ```html
                <p>Use this page to upload PDFs into the database. They should be from the same problem domain, like, for example, Oracle AI Database 26ai documentation.</p>
                <p>Once loaded, click on the <em>chunk-and-vectorise</em> button to create chunks and vector embeddings inside the database. The provided ONNX model, a sentence transformer, takes care of that step. Depending on the data volume it might take a while for the process to finish</p>
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/hero
            templateOptions: #DEFAULT#
            icon: fa-info-circle-o
        }
    )

    region breadcrumb (
        name: Breadcrumb
        type: breadcrumb
        source {
            breadcrumb: @breadcrumb
        }
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/title-bar
            templateOptions: [
                #DEFAULT#
                t-BreadcrumbRegion--useBreadcrumbTitle
            ]
        }
        componentAppearance {
            breadcrumbTemplate: @/breadcrumb
            templateOptions: #DEFAULT#
        }
    )

    region knowledge-sources (
        name: Knowledge Sources
        type: classicReport
        source {
            location: localDatabase
            tableName: DOCUMENTATION_TAB
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Region--noPadding
            ]
        }
        componentAppearance {
            template: @/standard
            templateOptions: [
                #DEFAULT#
                t-Report--stretch
                t-Report--staticRowColors
                t-Report--rowHighlight
                t-Report--inline
                t-Report--hideNoPagination
            ]
        }
        messages {
            whenNoDataFound: No data found.
        }

        column DOCUMENT_HASH (
            reportColumnQueryId: 3
            derivedColumn: N
            heading {
                heading: Document Hash
            }
            layout {
                sequence: 3
            }
            sorting {
                defaultSequence: 1
            }
        )

        column DOCUMENT_TITLE (
            reportColumnQueryId: 2
            derivedColumn: N
            heading {
                heading: Document Title
            }
            layout {
                sequence: 2
            }
            sorting {
                defaultSequence: 1
            }
        )

        column FILENAME (
            reportColumnQueryId: 4
            derivedColumn: N
            heading {
                heading: Filename
            }
            layout {
                sequence: 14
            }
        )

        column ID (
            reportColumnQueryId: 1
            derivedColumn: N
            type: link
            heading {
                alignment: center
            }
            layout {
                sequence: 0
                columnAlignment: center
            }
            link {
                target: {
                    page: 3
                    items: {
                        P3_ID: \#ID#\
                    }
                    action: resetPagination
                }
                linkText: <span role="img" aria-label="Edit" class="fa fa-edit" title="Edit"></span>
            }
            sorting {
                sortable: false
            }
        )

    )

    button chunk-and-vectorise_1 (
        buttonName: chunk-and-vectorise
        label: Chunk and vectorise
        layout {
            sequence: 20
            region: @breadcrumb
            slot: change
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-execute-plsql-code (
            action: executeServerSideCode
            settings {
                plsqlCode:
                    ```plsql
                    BEGIN
                        documentation_chunker.rebuild_all(
                            p_embedding_model => 'ALL_MINILM_L12_V2'
                        );
                    END;
                    
                    ```
            }
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 10
            region: @knowledge-sources
            slot: edit
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            action: redirectThisApp
            target: {
                page: 3
                clearCache: 3
            }
            warnOnUnsavedChanges: doNotCheck
        }
    )

    dynamicAction edit-report-dialog-closed (
        name: Edit Report - Dialog Closed
        execution {
            sequence: 10
        }
        when {
            event: apexafterclosedialog
            selectionType: region
            region: @knowledge-sources
        }

        action native-refresh (
            action: refresh
            affectedElements {
                selectionType: region
                region: @knowledge-sources
            }
            execution {
                sequence: 10
                fireOnInit: false
            }
        )

    )

)

