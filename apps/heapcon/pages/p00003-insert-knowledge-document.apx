page 3 (
    name: Insert Knowledge Document
    alias: INSERT-KNOWLEDGE-DOCUMENT
    title: Insert Knowledge Document
    appearance {
        pageMode: modalDialog
        dialogTemplate: @/drawer
        templateOptions: [
            #DEFAULT#
            js-dialog-class-t-Drawer--pullOutEnd
        ]
    }
    dialog {
        chained: false
    }

    region buttons (
        name: Buttons
        type: staticContent
        layout {
            sequence: 20
            slot: dialogFooter
        }
        appearance {
            template: @/buttons-container
            templateOptions: #DEFAULT#
        }
    )

    region insert-knowledge-document (
        name: Insert Knowledge Document
        type: form
        source {
            location: localDatabase
            tableName: DOCUMENTATION_TAB
        }
        layout {
            sequence: 10
            slot: contentBody
        }
        appearance {
            template: @/blank-with-attributes
            templateOptions: #DEFAULT#
        }
        edit {
            enabled: true
            allowedOperations: [
                add
                update
                delete
            ]
        }
    )

    pageItem P3_DATA (
        type: fileUpload
        label {
            label: Data
            alignment: left
        }
        storage {
            mimeTypeColumn: MIME_TYPE
            filenameColumn: FILENAME
            bobLastUpdatedColumn: UPDATED_AT
        }
        layout {
            sequence: 40
            region: @insert-knowledge-document
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 60
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @insert-knowledge-document
            column: DATA
            dataType: blob
        }
    )

    pageItem P3_DOCUMENT_HASH (
        type: hidden
        layout {
            sequence: 30
            region: @insert-knowledge-document
            slot: regionBody
        }
        source {
            formRegion: @insert-knowledge-document
            column: DOCUMENT_HASH
            dataType: varchar2
        }
    )

    pageItem P3_DOCUMENT_TITLE (
        type: textField
        label {
            label: Document Title
            alignment: right
        }
        layout {
            sequence: 20
            region: @insert-knowledge-document
            slot: regionBody
            alignment: left
        }
        appearance {
            template: @/optional-floating
            templateOptions: #DEFAULT#
            width: 32
        }
        validation {
            maxLength: 255
        }
        source {
            formRegion: @insert-knowledge-document
            column: DOCUMENT_TITLE
            dataType: varchar2
        }
    )

    pageItem P3_FILENAME (
        type: hidden
        layout {
            sequence: 10
            region: @insert-knowledge-document
            slot: regionBody
        }
        source {
            formRegion: @insert-knowledge-document
            column: FILENAME
            dataType: varchar2
        }
    )

    pageItem P3_ID (
        type: hidden
        layout {
            sequence: 10
            region: @insert-knowledge-document
            slot: regionBody
        }
        source {
            formRegion: @insert-knowledge-document
            column: ID
            dataType: number
            primaryKey: true
        }
        security {
            sessionStateProtection: checksumRequiredSessionLevel
        }
    )

    pageItem P3_MIME_TYPE (
        type: hidden
        layout {
            sequence: 10
            region: @insert-knowledge-document
            slot: regionBody
        }
        source {
            formRegion: @insert-knowledge-document
            column: MIME_TYPE
            dataType: varchar2
        }
    )

    pageItem P3_UPDATED_AT (
        type: hidden
        layout {
            sequence: 10
            region: @insert-knowledge-document
            slot: regionBody
        }
        source {
            formRegion: @insert-knowledge-document
            column: UPDATED_AT
            dataType: date
        }
    )

    button cancel (
        buttonName: CANCEL
        label: Cancel
        layout {
            sequence: 10
            region: @buttons
            slot: close
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            action: triggerAction
        }

        triggerAction native-dialog-cancel (
            action: cancelDialog
            execution {
                sequence: 10
            }
        )

    )

    button create (
        buttonName: CREATE
        label: Create
        layout {
            sequence: 40
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: insert
        }
        serverSideCondition {
            type: itemIsNull
            item: P3_ID
        }
    )

    button delete (
        buttonName: DELETE
        label: Delete
        layout {
            sequence: 20
            region: @buttons
            slot: delete
        }
        appearance {
            buttonTemplate: @/text
            templateOptions: #DEFAULT#
        }
        behavior {
            executeValidations: false
            warnOnUnsavedChanges: doNotCheck
            databaseAction: delete
            requiresConfirmation: true
        }
        confirmation {
            message: &APP_TEXT$DELETE_MSG!RAW.
            style: danger
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P3_ID
        }
    )

    button save (
        buttonName: SAVE
        label: Apply Changes
        layout {
            sequence: 30
            region: @buttons
            slot: next
        }
        appearance {
            buttonTemplate: @/text
            hot: true
            templateOptions: #DEFAULT#
        }
        behavior {
            warnOnUnsavedChanges: doNotCheck
            databaseAction: update
        }
        serverSideCondition {
            type: itemIsNotNull
            item: P3_ID
        }
    )

    process append-hash (
        name: Append hash
        type: executeCode
        source {
            plsqlCode:
                ```plsql
                UPDATE documentation_tab
                   SET document_hash = lower(rawtohex(
                       dbms_crypto.hash(data, dbms_crypto.hash_sh256)
                   ))
                 WHERE id = :P3_ID;
                ```
        }
        execution {
            sequence: 30
        }
        advanced {
            executionMappingIdentifier: 8638781005473603
        }
    )

    process close-dialog (
        name: Close Dialog
        type: closeDialog
        execution {
            sequence: 40
        }
        advanced {
            executionMappingIdentifier: 8632431356449455
        }
        serverSideCondition {
            type: requestIsContainedInValue
            value: CREATE,SAVE,DELETE
        }
    )

    process initialize-form-insert-knowledge-document (
        name: Initialize form Insert Knowledge Document
        type: formInitialization
        formRegion: @insert-knowledge-document
        execution {
            sequence: 10
            point: beforeHeader
        }
        advanced {
            executionMappingIdentifier: 8631639279449454
        }
    )

    process process-form-insert-knowledge-document (
        name: Process form Insert Knowledge Document
        type: formAutoRowProcessing
        formRegion: @insert-knowledge-document
        execution {
            sequence: 20
        }
        advanced {
            executionMappingIdentifier: 8632007286449455
        }
    )

)

