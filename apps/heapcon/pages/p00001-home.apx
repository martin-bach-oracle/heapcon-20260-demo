page 1 (
    name: Home
    alias: HOME
    title: Heapcon
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }

    region about-app (
        name: About this app
        title: About this app
        type: staticContent
        source {
            htmlCode: <p>This app demonstrates how Oracle APEX and Oracle AI Database can prepare documents for semantic search. Upload PDF documents, split them into chunks, generate vector embeddings, and search the documents by meaning.</p><p>Use <strong>Knowledge Sources</strong> to upload and process PDFs, then open <strong>Vector Search</strong> to find relevant passages. Finally, use the <strong>RAG Search</strong> to chat with the database</p><p>The app serves as a playground for APEX Generative AI Development.</p>
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/hero
            templateOptions: #DEFAULT#
            icon: fa-info-circle-o
        }
    )

    region gendev (
        name: GenDev illustrated
        type: staticContent
        layout {
            sequence: 30
            slot: body
        }
        appearance {
            template: @/image
            templateOptions: [
                #DEFAULT#
                t-ImageRegion--auto
                t-ImageRegion--cover
                t-ImageRegion--square
                t-ImageRegion--noFilter
            ]
        }
        image {
            fileUrl: #APP_FILES#images/gendevrealms-modern.png
        }
    )

    region heapcon (
        name: Heapcon
        type: staticContent
        layout {
            sequence: 10
            slot: breadcrumbBar
        }
        appearance {
            template: @/hero
            templateOptions: #DEFAULT#
        }
        image {
            fileUrl: #APP_FILES#icons/app-icon-512.png
        }
    )

)

