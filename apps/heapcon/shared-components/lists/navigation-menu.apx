list navigation-menu (
    name: Navigation Menu

    entry home (
        label: Home
        icon {
            imageIconCssClasses: fa-home
        }
        layout {
            sequence: 10
        }
        link {
            target: {
                page: 1
            }
        }
    )

    entry knowledge-sources (
        label: Knowledge Sources
        icon {
            imageIconCssClasses: fa-table
        }
        layout {
            sequence: 20
        }
        isCurrent {
            type: pages
            pages: [
                2
                3
            ]
        }
        link {
            target: {
                page: 2
            }
        }
    )

    entry rag-search (
        label: RAG Search
        icon {
            imageIconCssClasses: fa-comments
        }
        layout {
            sequence: 40
        }
        isCurrent {
            type: pages
            pages: 7
        }
        link {
            target: {
                page: 7
            }
        }
    )

    entry vector-search (
        label: Vector Search
        icon {
            imageIconCssClasses: fa-search
        }
        layout {
            sequence: 30
        }
        isCurrent {
            type: pages
            pages: 6
        }
        link {
            target: {
                page: 6
            }
        }
    )

)

